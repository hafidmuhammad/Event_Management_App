DATABASE_URL=mysql://root:password@127.0.0.1:3306/event_management
TEST_DATABASE_URL=mysql://root:password@127.0.0.1:3306/event_management_test
AUTH_SECRET=replace-with-a-long-random-development-secret
AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000
MAIL_TRANSPORT=preview
SMTP_PROTOCOL=smtp
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=your-mailbox@example.com
SMTP_PASS=replace-with-mailbox-password-or-app-password
SMTP_CRYPTO=tls
SMTP_CHARSET=utf-8
SMTP_MAILTYPE=html
SMTP_FROM=your-mailbox@example.com

# Secret for POST /api/cron/email-reminders (Authorization: Bearer <value>). Leave empty to disable the endpoint.
CRON_SECRET=
